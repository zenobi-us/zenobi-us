#!/usr/bin/env bash

# MISE description="Delete all Pages preview deployments for a project"

set -euo pipefail

API_BASE='https://api.cloudflare.com/client/v4'
PER_PAGE=25
: "${DRY_RUN:=0}"
: "${USE_OPEN_PR_CHECK:=1}"
: "${REQUIRE_GH_OPEN_PR_CHECK:=1}"

PROJECT_NAME="zenobius"
ACCOUNT_ID="${CF_ACCOUNT_ID:-}"
API_TOKEN=""
AUTH_HEADER=""
declare -A OPEN_PR_BRANCHES=()

auth_header() {
	printf 'Authorization: Bearer %s' "${API_TOKEN}"
}

print_usage() {
	cat <<'USAGE'
Usage:
  ./.mise/tasks/delete-preview-deployments <project-name>

Environment:
  CF_ACCOUNT_ID          Cloudflare account id (required)
  CF_PAGES_PROJECT       Optional project name fallback
  CF_API_TOKEN           Optional token
  CLOUDFLARE_API_TOKEN   Optional token
  DRY_RUN=1             Dry-run mode (print only)
  USE_OPEN_PR_CHECK=1    Enable filtering deployments for open PRs (default: 1)
  REQUIRE_GH_OPEN_PR_CHECK=1  Fail fast when gh/open PR check is unavailable (default: 1)
USAGE
}

resolve_project_name() {
	if [[ -n "${1:-}" ]]; then
		PROJECT_NAME="$1"
		return 0
	fi

	if [[ -n "${CF_PAGES_PROJECT:-}" ]]; then
		PROJECT_NAME="${CF_PAGES_PROJECT}"
		return 0
	fi

	return 1
}

require_prereqs() {
	if [[ -z "${PROJECT_NAME}" ]]; then
		echo "❌ Missing project name." >&2
		print_usage >&2
		return 1
	fi

	if [[ -z "${ACCOUNT_ID}" ]]; then
		echo "❌ Missing account ID." >&2
		echo "   Export CF_ACCOUNT_ID or pass CF_ACCOUNT_ID in environment." >&2
		return 1
	fi

	if [[ "${DRY_RUN}" != "0" && "${DRY_RUN}" != "1" ]]; then
		echo "❌ DRY_RUN must be 0 or 1." >&2
		return 1
	fi

	if ! command -v jq >/dev/null 2>&1; then
		echo "❌ jq is required for this script." >&2
		return 1
	fi

	if ! command -v curl >/dev/null 2>&1; then
		echo "❌ curl is required for this script." >&2
		return 1
	fi

	resolve_api_token || return 1
	AUTH_HEADER="$(auth_header)"
	return 0
}

resolve_api_token() {
	if [[ -n "${CF_API_TOKEN:-}" ]]; then
		API_TOKEN="${CF_API_TOKEN}"
		return 0
	fi

	if [[ -n "${CLOUDFLARE_API_TOKEN:-}" ]]; then
		API_TOKEN="${CLOUDFLARE_API_TOKEN}"
		return 0
	fi

	local token_file="$HOME/.config/.wrangler/config/default.toml"
	if [[ ! -f "${token_file}" ]]; then
		echo "❌ No token found. Set CF_API_TOKEN/CLOUDFLARE_API_TOKEN or login with wrangler." >&2
		return 1
	fi

	API_TOKEN="$(sed -n 's/^oauth_token *= "\([^\"]*\)"/\1/p' "${token_file}" | head -n 1)"
	if [[ -z "${API_TOKEN}" ]]; then
		echo "❌ Failed to extract token from ${token_file}" >&2
		return 1
	fi

	return 0
}

load_open_pr_branches() {
	if [[ "${USE_OPEN_PR_CHECK}" != "1" ]]; then
		echo "ℹ️  Open PR filtering disabled (USE_OPEN_PR_CHECK=0)."
		return 0
	fi
	if ! command -v gh >/dev/null 2>&1; then
		if [[ "${REQUIRE_GH_OPEN_PR_CHECK}" == "1" ]]; then
			echo "❌ gh CLI not found and REQUIRE_GH_OPEN_PR_CHECK=1." >&2
			return 1
		fi
		echo "⚠️  gh CLI not found. Skipping open PR filtering." >&2
		return 0
	fi

	local repo
	repo="$(gh repo view --json nameWithOwner --jq '.nameWithOwner' 2>/dev/null || true)"
	if [[ -z "${repo}" ]]; then
		if [[ "${REQUIRE_GH_OPEN_PR_CHECK}" == "1" ]]; then
			echo "❌ Failed to resolve GitHub repository via gh repo view." >&2
			return 1
		fi

		echo "⚠️  Failed to resolve repo. Skipping open PR filtering." >&2
		return 0
	fi
	local pr_numbers
	if ! pr_numbers="$(gh pr list --repo "${repo}" --state open --json number --jq '.[].number' 2>/dev/null)"; then
		if [[ "${REQUIRE_GH_OPEN_PR_CHECK}" == "1" ]]; then
			echo "❌ Failed to fetch open PRs for ${repo}." >&2
			return 1
		fi

		echo "⚠️  Failed to fetch open PRs for ${repo}. Skipping open PR filtering." >&2
		return 0
	fi
	if [[ -z "${pr_numbers}" ]]; then
		echo "ℹ️  No open PRs found for ${repo}."
		return 0
	fi
	while IFS= read -r pr_number; do
		if [[ -n "${pr_number}" ]]; then
			OPEN_PR_BRANCHES["pr/${pr_number}"]="1"
		fi
	done <<<"${pr_numbers}"
	echo "ℹ️  Loaded ${#OPEN_PR_BRANCHES[@]} open PR branch aliases from ${repo}."
}

is_open_pr_deployment() {
	local branch="$1"

	if [[ "${USE_OPEN_PR_CHECK}" != "1" ]]; then
		return 1
	fi

	[[ -n "${OPEN_PR_BRANCHES["${branch}"]:-}" ]]
}

request_deployments_page() {
	local page="$1"
	local url

	url="${API_BASE}/accounts/${ACCOUNT_ID}/pages/projects/${PROJECT_NAME}/deployments?page=${page}&per_page=${PER_PAGE}"

	curl -fsS -H "${AUTH_HEADER}" "${url}"
}

extract_preview_rows() {
	jq -r '.result[] | select(.environment=="preview") | [.id, .short_id, (.deployment_trigger.metadata.branch // "")] | @tsv'
}

extract_total_pages() {
	jq -r '.result_info.total_pages'
}

delete_preview_deployment() {
	local dep_id="$1"
	local short_id="$2"
	local branch="$3"

	if [[ "${DRY_RUN}" == "1" ]]; then
		echo "[dry-run] would delete ${short_id} (branch=${branch})"
		return 0
	fi

	local delete_url
	local delete_response
	local ok

	delete_url="${API_BASE}/accounts/${ACCOUNT_ID}/pages/projects/${PROJECT_NAME}/deployments/${dep_id}?force=true"
	delete_response="$(curl -fsS -X DELETE -H "${AUTH_HEADER}" "${delete_url}")"
	ok="$(jq -r '.success' <<<"${delete_response}")"

	if [[ "${ok}" == "true" ]]; then
		echo "✅ deleted ${short_id} (branch=${branch})"
		return 0
	fi

	echo "❌ failed to delete ${short_id} (branch=${branch})" >&2
	echo "${delete_response}" >&2
	return 1
}

main() {
	local page=1
	local total_pages=1
	local deleted=0
	local errors=0

	resolve_project_name "${1:-}" || {
		exit 1
	}

	if ! require_prereqs; then
		exit 1
	fi

	load_open_pr_branches

	while ((page <= total_pages)); do
		local response
		local current_page=$page

		response="$(request_deployments_page "${page}")"

		if [[ "$(jq -r '.success' <<<"${response}")" != "true" ]]; then
			echo "❌ Failed listing deployments on page ${current_page}" >&2
			echo "${response}" >&2
			exit 1
		fi

		if ((current_page == 1)); then
			total_pages="$(echo "${response}" | extract_total_pages)"
			echo "🔎 Listing preview deployments for ${PROJECT_NAME} (pages=${total_pages})"
		fi

		while IFS=$'\t' read -r dep_id short_id branch; do
			if [[ -z "${dep_id}" ]]; then
				continue
			fi

			branch="${branch:-<unknown>}"

			if is_open_pr_deployment "${branch}"; then
				echo "⏭️  skipping open PR deployment ${short_id} (branch=${branch})"
				continue
			fi

			if delete_preview_deployment "${dep_id}" "${short_id}" "${branch}"; then
				((deleted += 1))
			else
				((errors += 1))
			fi
		done < <(echo "${response}" | extract_preview_rows)

		((page += 1))
	done

	if ((errors > 0)); then
		echo "⚠️  Finished with ${errors} deletion errors." >&2
		exit 1
	fi

	echo "✅ Done. Deleted ${deleted} preview deployment(s) for '${PROJECT_NAME}'."
}

main "$@"
